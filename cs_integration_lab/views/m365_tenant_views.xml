<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Microsoft 365 Tenant Tree View -->
    <record id="view_m365_tenant_tree" model="ir.ui.view">
        <field name="name">cs.m365.tenant.tree</field>
        <field name="model">cs.m365.tenant</field>
        <field name="arch" type="xml">
            <list string="Microsoft 365 Tenants">
                <field name="name"/>
                <field name="primary_domain"/>
                <field name="tenant_id"/>
                <field name="readiness_status" widget="badge" 
                       decoration-success="readiness_status == 'ready'"
                       decoration-warning="readiness_status == 'partial'"
                       decoration-danger="readiness_status == 'failed'"/>
                <field name="domain_count"/>
                <field name="available_license_capacity"/>
                <field name="last_readiness_check"/>
            </list>
        </field>
    </record>

    <!-- Microsoft 365 Tenant Form View -->
    <record id="view_m365_tenant_form" model="ir.ui.view">
        <field name="name">cs.m365.tenant.form</field>
        <field name="model">cs.m365.tenant</field>
        <field name="arch" type="xml">
            <form string="Microsoft 365 Tenant">
                <header>
                    <button name="action_check_readiness" string="Check Readiness / Discover Tenant" 
                            type="object" class="oe_highlight"/>
                    <field name="readiness_status" widget="statusbar" 
                           statusbar_visible="draft,ready,partial,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identity &amp; Domains">
                            <field name="tenant_id" readonly="1"/>
                            <field name="primary_domain" readonly="1"/>
                            <field name="domain_count" readonly="1"/>
                            <field name="last_readiness_check" readonly="1"/>
                        </group>
                        <group string="License Capacity">
                            <field name="total_license_capacity" readonly="1"/>
                            <field name="consumed_license_capacity" readonly="1"/>
                            <field name="available_license_capacity" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Discovered Domains">
                            <field name="domain_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="is_default"/>
                                    <field name="is_initial"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Subscribed SKUs / Licenses">
                            <field name="sku_ids" readonly="1">
                                <list>
                                    <field name="sku_part_number"/>
                                    <field name="sku_id"/>
                                    <field name="capability_status"/>
                                    <field name="enabled_units"/>
                                    <field name="consumed_units"/>
                                    <field name="available_units"/>
                                </list>
                            </field>
                        </page>

                        <page string="LAB Test Groups">
                            <field name="group_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="graph_id"/>
                                    <field name="group_type"/>
                                    <field name="mail_nickname"/>
                                    <field name="is_lab_group"/>
                                </list>
                            </field>
                        </page>

                        <page string="Graph Capabilities">
                            <field name="capability_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'available'"
                                           decoration-warning="status == 'denied'"
                                           decoration-muted="status == 'unsupported'"
                                           decoration-danger="status == 'failed'"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                        </page>

                        <page string="Discovery Warnings" invisible="not discovery_errors">
                            <field name="discovery_errors" readonly="1"/>
                        </page>

                        <page string="Error Details" invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_m365_tenant" model="ir.actions.act_window">
        <field name="name">Microsoft 365 Tenants</field>
        <field name="res_model">cs.m365.tenant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Microsoft 365 Tenants discovered yet.
            </p>
            <p>
                Create a tenant record and click "Check Readiness / Discover Tenant" to run dynamic Graph discovery.
            </p>
        </field>
    </record>
</odoo>
