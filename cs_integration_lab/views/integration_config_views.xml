<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Integration Config List View -->
        <record id="view_cs_integration_config_tree" model="ir.ui.view">
            <field name="name">cs.integration.config.tree</field>
            <field name="model">cs.integration.config</field>
            <field name="arch" type="xml">
                <list string="Integration Configurations">
                    <header>
                        <button name="action_sync_now" string="Sync Now" type="object" class="btn-primary" groups="cs_integration_lab.group_integration_manager"/>
                    </header>
                    <field name="name"/>
                    <field name="provider"/>
                    <field name="active"/>
                    <field name="schedule_enabled"/>
                    <field name="last_sync_at"/>
                    <field name="next_sync_at"/>
                </list>
            </field>
        </record>

        <!-- Integration Config Form View -->
        <record id="view_cs_integration_config_form" model="ir.ui.view">
            <field name="name">cs.integration.config.form</field>
            <field name="model">cs.integration.config</field>
            <field name="arch" type="xml">
                <form string="Integration Configuration">
                    <header>
                        <button name="action_sync_now" string="Sync Now" type="object" class="oe_highlight" groups="cs_integration_lab.group_integration_manager"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="e.g. GitHub Integration"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="provider"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="schedule_enabled"/>
                                <field name="last_sync_at"/>
                                <field name="next_sync_at"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Integration Config Action -->
        <record id="action_cs_integration_config" model="ir.actions.act_window">
            <field name="name">Integrations</field>
            <field name="res_model">cs.integration.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first integration configuration!
                </p>
                <p>
                    Configure external integrations for GitHub, JSONPlaceholder, Frankfurter, Open-Meteo, or Nager.Date.
                </p>
            </field>
        </record>

        <!-- Server Action for Sync Now in Action Dropdown Menu -->
        <record id="action_server_cs_integration_sync_now" model="ir.actions.server">
            <field name="name">Sync Now</field>
            <field name="model_id" ref="model_cs_integration_config"/>
            <field name="binding_model_id" ref="model_cs_integration_config"/>
            <field name="binding_view_types">list,form</field>
            <field name="groups_id" eval="[(4, ref('cs_integration_lab.group_integration_manager'))]"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.action_sync_now()
            </field>
        </record>
    </data>
</odoo>
