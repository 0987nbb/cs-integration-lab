# ---------------------------------------------------------------------------
# Odoo 19 (JSON-2 API, Bearer token)
# ---------------------------------------------------------------------------
ODOO_URL=https://your-database.odoo.com
ODOO_DATABASE=your_database
ODOO_API_KEY=your_api_key
ODOO_TIMEOUT=30

# ---------------------------------------------------------------------------
# Global HTTP reliability settings (apply to every outbound connector)
# ---------------------------------------------------------------------------
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_FACTOR=0.5
HTTP_BACKOFF_MAX=30
HTTP_USER_AGENT=cs-integration-lab/1.0

# Global cap on records processed per entity per run (keeps demo data tidy).
SYNC_SAMPLE_LIMIT=10

# When true, no write ever reaches Odoo or an external API; every mutation is
# emitted to the log prefixed with [MOCK WRITE].
DRY_RUN=false

# ---------------------------------------------------------------------------
# 1) GitHub REST API
#     GET/POST https://api.github.com/repos/{owner}/{repo}/issues
# ---------------------------------------------------------------------------
GITHUB_API_URL=https://api.github.com
# Personal access token with `repo` (or `public_repo`) scope.
# Leave EMPTY to run the connector read-only: inbound sync still runs, and every
# outbound POST/PATCH is emitted as [MOCK WRITE] instead of being sent.
GITHUB_TOKEN=
GITHUB_OWNER=octocat
GITHUB_REPO=Hello-World
# Odoo project that GitHub issues are synchronised into (created if missing).
GITHUB_PROJECT_NAME=GitHub Issues
# Fetch issue comments (1 extra request per issue).
GITHUB_SYNC_COMMENTS=true
GITHUB_PER_PAGE=100

# ---------------------------------------------------------------------------
# 2) JSONPlaceholder
#     GET        {base}/users
#     GET/POST   {base}/posts
#     PATCH      {base}/posts/{id}
# ---------------------------------------------------------------------------
# Primary host named by the assessment. It is currently unreachable from most
# networks (DNS/connect timeout), so the fallback host below is used
# automatically when the primary cannot be contacted.
JSONPLACEHOLDER_BASE_URL=https://api.jsonplaceholder.dev
JSONPLACEHOLDER_FALLBACK_BASE_URL=https://jsonplaceholder.typicode.com
# Odoo model that Posts are mapped to. helpdesk.ticket when Helpdesk is
# installed, otherwise project.task.
JSONPLACEHOLDER_POST_MODEL=helpdesk.ticket

# ---------------------------------------------------------------------------
# 3) Frankfurter v2
#     GET https://api.frankfurter.dev/v2/rates?base=USD&quotes=EUR,GBP,TRY,PKR
# ---------------------------------------------------------------------------
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
FRANKFURTER_BASE_CURRENCY=USD
FRANKFURTER_QUOTES=EUR,GBP,TRY,PKR
# Relative change above which a rate is NOT written automatically; a mail.activity
# is raised for Administrator approval instead. 0.05 == 5%.
FRANKFURTER_RATE_CHANGE_THRESHOLD=0.05
# Login of the user the approval activity is assigned to.
FRANKFURTER_APPROVER_LOGIN=

# ---------------------------------------------------------------------------
# 4) Open-Meteo
#     GET https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}
#         &daily=temperature_2m_max,temperature_2m_min&timezone=auto
# ---------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_FORECAST_DAYS=7
# Comma-separated res.partner ids to forecast. Leave empty to auto-select
# partners that have partner_latitude/partner_longitude set.
OPEN_METEO_PARTNER_IDS=

# ---------------------------------------------------------------------------
# 5) Nager.Date
#     GET https://date.nager.at/api/v4/Holidays/{CountryCode}/{Year}
# ---------------------------------------------------------------------------
NAGER_BASE_URL=https://date.nager.at
# Comma-separated ISO-3166-1 alpha-2 codes. Note: the provider has no data for
# PK and answers HTTP 204 for it; such countries are counted as skipped.
NAGER_COUNTRIES=US,DE
# Comma-separated years. Leave empty to use the current year.
NAGER_YEARS=

# ---------------------------------------------------------------------------
# Scheduled sync   (python -m integration_service.cli --schedule [--once])
# ---------------------------------------------------------------------------
# Default interval for every provider, in minutes.
SCHEDULE_INTERVAL_MINUTES=60
# Per-provider overrides. FX rates publish once per working day; holidays change
# once a year; issues and forecasts are worth polling more often.
SCHEDULE_GITHUB_MINUTES=15
SCHEDULE_JSONPLACEHOLDER_MINUTES=360
SCHEDULE_FRANKFURTER_MINUTES=720
SCHEDULE_OPEN_METEO_MINUTES=180
SCHEDULE_NAGER_DATE_MINUTES=1440

# ---------------------------------------------------------------------------
# Sync log fallback
# ---------------------------------------------------------------------------
# Used when x_integration_sync_log is not writable (e.g. no access rule yet).
SYNC_LOG_FALLBACK_PATH=logs/sync_log.jsonl
